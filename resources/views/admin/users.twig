{% extends 'layouts/admin.twig' %}

{% set active_page = 'users' %}

{% block title %}İstifadəçilər — Admin{% endblock %}
{% block heading %}İstifadəçi idarəetməsi{% endblock %}

{% block content %}
<div x-data="usersAdmin()" x-init="load()">
    <div class="flex flex-col sm:flex-row gap-3 mb-6">
        <input
            x-model="filters.search"
            @input.debounce.300ms="load(1)"
            type="text"
            placeholder="Ad və ya e-poçt ilə axtar..."
            class="flex-1 px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900">

        <select x-model="filters.role" @change="load(1)" class="px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900">
            <option value="">Bütün rollar</option>
            <option value="super_admin">Super Admin</option>
            <option value="admin">Admin</option>
            <option value="pro_user">Pro</option>
            <option value="free_user">Free</option>
        </select>

        <select x-model="filters.status" @change="load(1)" class="px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900">
            <option value="">Bütün statuslar</option>
            <option value="active">Aktiv</option>
            <option value="inactive">Deaktiv</option>
        </select>
    </div>

    <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-sm">
                <thead class="bg-slate-50 dark:bg-slate-950/50 text-left text-xs uppercase tracking-wider text-slate-500">
                    <tr>
                        <th class="px-6 py-3 font-semibold">İstifadəçi</th>
                        <th class="px-6 py-3 font-semibold">Rol</th>
                        <th class="px-6 py-3 font-semibold text-right">Linklər</th>
                        <th class="px-6 py-3 font-semibold text-right">Kliklər</th>
                        <th class="px-6 py-3 font-semibold">Status</th>
                        <th class="px-6 py-3 font-semibold">Son giriş</th>
                        <th class="px-6 py-3 font-semibold text-right">Əməliyyatlar</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 dark:divide-slate-800">
                    <template x-for="u in users" :key="u.uuid">
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-950/50">
                            <td class="px-6 py-4">
                                <div class="font-medium" x-text="u.name"></div>
                                <div class="text-xs text-slate-500" x-text="u.email"></div>
                            </td>
                            <td class="px-6 py-4">
                                <select :value="u.role" @change="updateRole(u, $event.target.value)" class="text-xs px-2.5 py-1 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900">
                                    <option value="free_user">Free</option>
                                    <option value="pro_user">Pro</option>
                                    <option value="admin">Admin</option>
                                    <option value="super_admin">Super Admin</option>
                                </select>
                            </td>
                            <td class="px-6 py-4 text-right font-semibold" x-text="u.link_count.toLocaleString()"></td>
                            <td class="px-6 py-4 text-right font-semibold" x-text="u.total_clicks.toLocaleString()"></td>
                            <td class="px-6 py-4">
                                <span :class="u.is_active ? 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400' : 'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400'" class="text-xs px-2.5 py-1 rounded-full font-semibold" x-text="u.is_active ? 'Aktiv' : 'Bloklu'"></span>
                            </td>
                            <td class="px-6 py-4 text-slate-500 text-xs" x-text="u.last_login_at ? formatDate(u.last_login_at) : '—'"></td>
                            <td class="px-6 py-4 text-right">
                                <button @click="toggleActive(u)" class="text-sm font-medium" :class="u.is_active ? 'text-red-600 hover:text-red-700' : 'text-green-600 hover:text-green-700'">
                                    <span x-text="u.is_active ? 'Blokla' : 'Aktivləşdir'"></span>
                                </button>
                            </td>
                        </tr>
                    </template>
                </tbody>
            </table>
        </div>

        <div x-show="meta.total_pages > 1" class="flex justify-between px-6 py-3 border-t border-slate-200 dark:border-slate-800">
            <span class="text-sm text-slate-500">Səhifə <span x-text="meta.page"></span> / <span x-text="meta.total_pages"></span> (cəmi <span x-text="meta.total"></span>)</span>
            <div class="flex gap-2">
                <button @click="load(meta.page - 1)" :disabled="meta.page <= 1" class="px-3 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 disabled:opacity-50">Əvvəlki</button>
                <button @click="load(meta.page + 1)" :disabled="meta.page >= meta.total_pages" class="px-3 py-1.5 rounded-lg border border-slate-300 dark:border-slate-700 disabled:opacity-50">Növbəti</button>
            </div>
        </div>
    </div>
</div>

<script>
function usersAdmin() {
    return {
        users: [],
        meta: { page: 1, total: 0, total_pages: 1 },
        filters: { search: '', role: '', status: '' },
        async load(page = 1) {
            const url = new URL('/api/v1/admin/users', window.location.origin);
            url.searchParams.set('page', page);
            if (this.filters.search) url.searchParams.set('search', this.filters.search);
            if (this.filters.role)   url.searchParams.set('role',   this.filters.role);
            if (this.filters.status) url.searchParams.set('status', this.filters.status);

            const json = await (await window.lfFetch(url)).json();
            if (json.success) { this.users = json.data; this.meta = json.meta; }
        },
        async updateRole(u, newRole) {
            if (!confirm(`${u.name} istifadəçisinin rolunu "${newRole}" olaraq dəyişdirmək istədiyinizə əminsiniz?`)) {
                this.load(this.meta.page);
                return;
            }
            const res = await window.lfFetch('/api/v1/admin/users/' + u.uuid + '/role', { method: 'PATCH', body: JSON.stringify({ role: newRole }) });
            const json = await res.json();
            if (!json.success) { alert(json.error?.message ?? 'Xəta'); this.load(this.meta.page); }
            else { u.role = newRole; }
        },
        async toggleActive(u) {
            const action = u.is_active ? 'bloklamaq' : 'aktivləşdirmək';
            if (!confirm(`${u.name} istifadəçisini ${action} istədiyinizə əminsiniz?`)) return;
            const res = await window.lfFetch('/api/v1/admin/users/' + u.uuid + '/toggle-active', { method: 'PATCH' });
            const json = await res.json();
            if (json.success) u.is_active = json.data.is_active;
            else alert(json.error?.message ?? 'Xəta');
        },
        formatDate(iso) {
            return new Date(iso).toLocaleString('az-AZ', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
        },
    }
}
</script>
{% endblock %}
