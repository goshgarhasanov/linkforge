<div
    x-data="createModal()"
    @open-create-modal.window="open()"
    @keydown.escape.window="visible = false"
    x-show="visible"
    x-cloak
    class="fixed inset-0 z-50 flex items-center justify-center p-4"
    x-transition.opacity>

    <div @click="visible = false" class="absolute inset-0 bg-black/60 backdrop-blur-sm"></div>

    <div
        x-show="visible"
        x-transition.scale.95
        class="relative bg-white dark:bg-slate-900 rounded-2xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto">

        <div class="sticky top-0 bg-white dark:bg-slate-900 px-6 py-4 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between">
            <h2 class="text-xl font-bold">Yeni link yarat</h2>
            <button @click="visible = false" class="p-2 rounded-lg hover:bg-slate-100 dark:hover:bg-slate-800">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <form @submit.prevent="submit" class="p-6 space-y-5">
            <div>
                <label class="block text-sm font-medium mb-2">Uzun URL <span class="text-red-500">*</span></label>
                <input
                    x-model="form.url"
                    type="url"
                    required
                    placeholder="https://example.com/cox-uzun-link"
                    class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 focus:ring-2 focus:ring-brand-500 focus:border-transparent">
            </div>

            <div class="grid sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-sm font-medium mb-2">Xüsusi alias <span class="text-xs text-slate-500 font-normal">(opsional)</span></label>
                    <div class="flex">
                        <span class="inline-flex items-center px-3 rounded-l-xl border border-r-0 border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-950/50 text-sm text-slate-500">{{ app_url ?? 'localhost' }}/</span>
                        <input
                            x-model="form.alias"
                            type="text"
                            pattern="[a-zA-Z0-9_-]{3,32}"
                            placeholder="menim-linkim"
                            class="flex-1 px-4 py-3 rounded-r-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 focus:ring-2 focus:ring-brand-500 focus:border-transparent">
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium mb-2">Başlıq <span class="text-xs text-slate-500 font-normal">(opsional)</span></label>
                    <input
                        x-model="form.title"
                        type="text"
                        maxlength="255"
                        placeholder="Portfolio saytım"
                        class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 focus:ring-2 focus:ring-brand-500 focus:border-transparent">
                </div>
            </div>

            <details class="rounded-xl border border-slate-200 dark:border-slate-800">
                <summary class="cursor-pointer px-4 py-3 font-medium hover:bg-slate-50 dark:hover:bg-slate-950/50 rounded-xl">
                    Qabaqcıl tənzimləmələr
                </summary>
                <div class="p-4 pt-2 space-y-4">
                    <div>
                        <label class="block text-sm font-medium mb-2">Şifrə qoruması</label>
                        <input
                            x-model="form.password"
                            type="text"
                            minlength="4"
                            placeholder="Boş buraxın — şifrəsiz olsun"
                            class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 focus:ring-2 focus:ring-brand-500 focus:border-transparent">
                    </div>

                    <div class="grid sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium mb-2">Bitmə tarixi</label>
                            <input
                                x-model="form.expires_at"
                                type="datetime-local"
                                class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 focus:ring-2 focus:ring-brand-500 focus:border-transparent">
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Maksimum klik</label>
                            <input
                                x-model="form.max_clicks"
                                type="number"
                                min="1"
                                placeholder="Limitsiz"
                                class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 focus:ring-2 focus:ring-brand-500 focus:border-transparent">
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium mb-2">UTM parametrləri</label>
                        <div class="grid grid-cols-3 gap-2">
                            <input x-model="form.utm.source"   type="text" placeholder="source"   class="px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-sm">
                            <input x-model="form.utm.medium"   type="text" placeholder="medium"   class="px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-sm">
                            <input x-model="form.utm.campaign" type="text" placeholder="campaign" class="px-3 py-2 rounded-lg border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-sm">
                        </div>
                    </div>

                    <div class="grid sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium mb-2">iOS deep link</label>
                            <input x-model="form.ios_deep_link" type="text" placeholder="myapp://..." class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-sm">
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Android deep link</label>
                            <input x-model="form.android_deep_link" type="text" placeholder="myapp://..." class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-950 text-sm">
                        </div>
                    </div>
                </div>
            </details>

            <div x-show="error" x-cloak class="px-4 py-3 rounded-lg bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-900 text-red-700 dark:text-red-400 text-sm" x-text="error"></div>

            <div x-show="result" x-cloak class="p-4 rounded-xl bg-green-50 dark:bg-green-950/30 border border-green-200 dark:border-green-900">
                <p class="text-sm text-green-700 dark:text-green-400 mb-2">✓ Link uğurla yaradıldı!</p>
                <div class="flex items-center gap-2">
                    <input :value="result?.short_url" readonly class="flex-1 px-3 py-2 rounded-lg bg-white dark:bg-slate-900 border border-green-200 dark:border-green-900 font-mono text-sm">
                    <button @click="navigator.clipboard.writeText(result.short_url)" type="button" class="px-3 py-2 rounded-lg bg-green-600 text-white text-sm font-medium hover:bg-green-700 transition">Kopyala</button>
                </div>
            </div>

            <div class="flex justify-end gap-3 pt-2">
                <button @click="visible = false" type="button" class="px-5 py-2.5 rounded-xl border border-slate-300 dark:border-slate-700 font-medium hover:bg-slate-50 dark:hover:bg-slate-800 transition">
                    Ləğv et
                </button>
                <button
                    type="submit"
                    :disabled="loading"
                    class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-brand-600 to-purple-600 text-white font-semibold shadow-lg shadow-brand-500/30 disabled:opacity-50 hover:shadow-xl transition">
                    <span x-show="!loading">Link yarat</span>
                    <span x-show="loading">Yaradılır...</span>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function createModal() {
    return {
        visible: false,
        loading: false,
        error: '',
        result: null,
        form: {
            url: '', alias: '', title: '', password: '',
            expires_at: '', max_clicks: '',
            utm: { source: '', medium: '', campaign: '' },
            ios_deep_link: '', android_deep_link: '',
        },
        open() {
            this.reset();
            this.visible = true;
        },
        reset() {
            this.error = '';
            this.result = null;
            this.form = {
                url: '', alias: '', title: '', password: '',
                expires_at: '', max_clicks: '',
                utm: { source: '', medium: '', campaign: '' },
                ios_deep_link: '', android_deep_link: '',
            };
        },
        async submit() {
            this.loading = true;
            this.error = '';

            const payload = { url: this.form.url };
            if (this.form.alias)             payload.alias = this.form.alias;
            if (this.form.title)             payload.title = this.form.title;
            if (this.form.password)          payload.password = this.form.password;
            if (this.form.expires_at)        payload.expires_at = new Date(this.form.expires_at).toISOString();
            if (this.form.max_clicks)        payload.max_clicks = parseInt(this.form.max_clicks);
            if (this.form.ios_deep_link)     payload.ios_deep_link = this.form.ios_deep_link;
            if (this.form.android_deep_link) payload.android_deep_link = this.form.android_deep_link;

            const utm = {};
            if (this.form.utm.source)   utm.source   = this.form.utm.source;
            if (this.form.utm.medium)   utm.medium   = this.form.utm.medium;
            if (this.form.utm.campaign) utm.campaign = this.form.utm.campaign;
            if (Object.keys(utm).length) payload.utm = utm;

            try {
                const res = await window.lfFetch('/api/v1/links', { method: 'POST', body: JSON.stringify(payload) });
                const json = await res.json();
                if (json.success) {
                    this.result = json.data;
                    document.dispatchEvent(new CustomEvent('link-created'));
                } else if (json.error?.fields) {
                    this.error = Object.values(json.error.fields).flat().join(' ');
                } else {
                    this.error = json.error?.message ?? 'Link yaradılmadı.';
                }
            } catch (e) {
                this.error = 'Bağlantı xətası.';
            } finally {
                this.loading = false;
            }
        },
    }
}
</script>
