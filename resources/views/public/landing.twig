{% extends 'layouts/base.twig' %}

{% block title %}LinkForge — {{ t('common.tagline') }}{% endblock %}

{% block body %}
{% include 'partials/nav.twig' %}

<main>
    <section class="relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-brand-50 via-white to-purple-50 dark:from-slate-950 dark:via-slate-900 dark:to-purple-950/30"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(99,102,241,0.15),transparent_50%)]"></div>

        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-24 sm:pt-28 sm:pb-32">
            <div class="text-center max-w-4xl mx-auto animate-slide-up">
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-100 dark:bg-brand-900/30 text-brand-700 dark:text-brand-300 text-sm font-medium mb-6">
                    <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
                    {{ t('landing.badge') }}
                </div>
                <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight mb-6">
                    {{ t('landing.hero_title_1') }} <span class="gradient-text">{{ t('landing.hero_title_2') }}</span> {{ t('landing.hero_title_3') }}
                </h1>
                <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-400 mb-10 max-w-2xl mx-auto leading-relaxed">
                    {{ t('landing.hero_subtitle') }}
                </p>

                <form
                    x-data="shortener()"
                    @submit.prevent="shorten"
                    class="max-w-2xl mx-auto bg-white dark:bg-slate-900 rounded-2xl shadow-2xl shadow-brand-500/10 p-2 flex flex-col sm:flex-row gap-2 mb-8 border border-slate-200 dark:border-slate-800">
                    <input
                        x-model="url"
                        type="url"
                        required
                        placeholder="{{ t('landing.input_placeholder') }}"
                        class="flex-1 px-5 py-4 bg-transparent border-0 focus:ring-0 text-slate-900 dark:text-white placeholder-slate-400 text-base">
                    <button
                        type="submit"
                        :disabled="loading"
                        class="px-8 py-4 rounded-xl bg-gradient-to-r from-brand-600 to-purple-600 text-white font-semibold shadow-lg shadow-brand-500/30 hover:shadow-xl hover:shadow-brand-500/40 disabled:opacity-50 disabled:cursor-not-allowed transition">
                        <span x-show="!loading">{{ t('landing.shorten_button') }}</span>
                        <span x-show="loading">{{ t('common.loading') }}</span>
                    </button>
                </form>

                <div class="flex items-center justify-center gap-6 text-sm text-slate-500 dark:text-slate-400">
                    <span class="flex items-center gap-1"><svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> {{ t('landing.free_to_start') }}</span>
                    <span class="flex items-center gap-1"><svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> {{ t('landing.no_card_required') }}</span>
                    <span class="flex items-center gap-1"><svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> {{ t('landing.uptime') }}</span>
                </div>
            </div>
        </div>
    </section>

    <section id="features" class="py-24 bg-white dark:bg-slate-950">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <span class="text-brand-600 dark:text-brand-400 font-semibold text-sm uppercase tracking-wider">{{ t('nav.features') }}</span>
                <h2 class="text-4xl sm:text-5xl font-bold mt-3 mb-4">{{ t('landing.features_title') }}</h2>
                <p class="text-lg text-slate-600 dark:text-slate-400">{{ t('landing.features_subtitle') }}</p>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% set features = [
                    { icon: '📊', key: 'analytics' },
                    { icon: '🎯', key: 'alias' },
                    { icon: '🔒', key: 'password' },
                    { icon: '⏰', key: 'expiration' },
                    { icon: '📱', key: 'qr' },
                    { icon: '🚀', key: 'api' },
                    { icon: '🌍', key: 'geo' },
                    { icon: '🛡️', key: 'bot' },
                    { icon: '📦', key: 'bulk' },
                ] %}

                {% for f in features %}
                <div class="group p-6 rounded-2xl bg-gradient-to-br from-slate-50 to-white dark:from-slate-900 dark:to-slate-900/50 border border-slate-200 dark:border-slate-800 hover:border-brand-300 dark:hover:border-brand-700 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
                    <div class="text-4xl mb-4">{{ f.icon }}</div>
                    <h3 class="text-lg font-semibold mb-2 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition">{{ t('features.' ~ f.key ~ '_title') }}</h3>
                    <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">{{ t('features.' ~ f.key ~ '_desc') }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section class="py-20 bg-gradient-to-br from-brand-600 to-purple-700 text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
                <div><div class="text-5xl font-extrabold mb-2">10M+</div><div class="text-brand-100">{{ t('admin.links') }}</div></div>
                <div><div class="text-5xl font-extrabold mb-2">450M+</div><div class="text-brand-100">{{ t('admin.clicks') }}</div></div>
                <div><div class="text-5xl font-extrabold mb-2">180+</div><div class="text-brand-100">{{ t('analytics.countries') }}</div></div>
                <div><div class="text-5xl font-extrabold mb-2">99.99%</div><div class="text-brand-100">Uptime</div></div>
            </div>
        </div>
    </section>

    <section id="pricing" class="py-24 bg-slate-50 dark:bg-slate-900">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <span class="text-brand-600 dark:text-brand-400 font-semibold text-sm uppercase tracking-wider">{{ t('nav.pricing') }}</span>
                <h2 class="text-4xl sm:text-5xl font-bold mt-3 mb-4">{{ t('pricing.title') }}</h2>
                <p class="text-lg text-slate-600 dark:text-slate-400">{{ t('pricing.subtitle') }}</p>
            </div>

            <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
                <div class="p-8 rounded-2xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
                    <h3 class="text-lg font-semibold mb-2">{{ t('pricing.free_name') }}</h3>
                    <div class="text-4xl font-bold mb-1">$0<span class="text-base font-normal text-slate-500">{{ t('pricing.per_month') }}</span></div>
                    <p class="text-sm text-slate-500 mb-6">{{ t('pricing.free_desc') }}</p>
                    <ul class="space-y-3 text-sm mb-8">
                        <li class="flex gap-2">✓ 50 {{ t('admin.links') }}/{{ locale() == 'az' ? 'ay' : 'month' }}</li>
                        <li class="flex gap-2">✓ {{ t('features.analytics_title') }}</li>
                        <li class="flex gap-2">✓ {{ t('features.qr_title') }}</li>
                    </ul>
                    <a href="/register" class="block text-center py-3 rounded-lg border border-slate-300 dark:border-slate-700 font-medium hover:bg-slate-100 dark:hover:bg-slate-800 transition">{{ t('pricing.get_started') }}</a>
                </div>

                <div class="p-8 rounded-2xl bg-gradient-to-br from-brand-600 to-purple-600 text-white shadow-2xl shadow-brand-500/30 transform md:scale-105">
                    <div class="inline-block px-3 py-1 rounded-full bg-white/20 text-xs font-semibold mb-3">{{ t('pricing.popular') }}</div>
                    <h3 class="text-lg font-semibold mb-2">{{ t('pricing.pro_name') }}</h3>
                    <div class="text-4xl font-bold mb-1">$19<span class="text-base font-normal opacity-80">{{ t('pricing.per_month') }}</span></div>
                    <p class="text-sm opacity-80 mb-6">{{ t('pricing.pro_desc') }}</p>
                    <ul class="space-y-3 text-sm mb-8">
                        <li class="flex gap-2">✓ 5,000 {{ t('admin.links') }}/{{ locale() == 'az' ? 'ay' : 'month' }}</li>
                        <li class="flex gap-2">✓ {{ t('features.analytics_title') }}</li>
                        <li class="flex gap-2">✓ {{ t('features.alias_title') }}</li>
                        <li class="flex gap-2">✓ {{ t('features.api_title') }}</li>
                        <li class="flex gap-2">✓ {{ t('features.password_title') }}</li>
                    </ul>
                    <a href="/register?plan=pro" class="block text-center py-3 rounded-lg bg-white text-brand-700 font-semibold hover:bg-slate-50 transition">{{ t('pricing.upgrade') }}</a>
                </div>

                <div class="p-8 rounded-2xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
                    <h3 class="text-lg font-semibold mb-2">{{ t('pricing.enterprise_name') }}</h3>
                    <div class="text-4xl font-bold mb-1">{{ t('pricing.custom') }}</div>
                    <p class="text-sm text-slate-500 mb-6">{{ t('pricing.enterprise_desc') }}</p>
                    <ul class="space-y-3 text-sm mb-8">
                        <li class="flex gap-2">✓ {{ t('features.api_title') }}</li>
                        <li class="flex gap-2">✓ SSO / SAML</li>
                        <li class="flex gap-2">✓ SLA</li>
                        <li class="flex gap-2">✓ Dedicated support</li>
                    </ul>
                    <a href="/contact" class="block text-center py-3 rounded-lg border border-slate-300 dark:border-slate-700 font-medium hover:bg-slate-100 dark:hover:bg-slate-800 transition">{{ t('pricing.contact_us') }}</a>
                </div>
            </div>
        </div>
    </section>

    <section class="py-24 bg-white dark:bg-slate-950">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="text-4xl sm:text-5xl font-bold mb-6">{{ t('landing.cta_title') }}</h2>
            <p class="text-lg text-slate-600 dark:text-slate-400 mb-8">{{ t('landing.cta_subtitle') }}</p>
            <a href="/register" class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-gradient-to-r from-brand-600 to-purple-600 text-white font-semibold shadow-xl shadow-brand-500/30 hover:shadow-2xl hover:shadow-brand-500/40 transition">
                {{ t('landing.cta_button') }}
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
        </div>
    </section>
</main>

{% include 'partials/footer.twig' %}

<script>
function shortener() {
    return {
        url: '', loading: false,
        async shorten() {
            if (!this.url) return;
            this.loading = true;
            try {
                const res = await fetch('/api/v1/links', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ url: this.url }),
                });
                const json = await res.json();
                if (json.success) {
                    window.location.href = '/register?prefill=' + encodeURIComponent(json.data.short_url);
                } else {
                    alert(json.error?.message ?? 'Error');
                }
            } catch (e) {
                alert('Connection error.');
            } finally {
                this.loading = false;
            }
        }
    }
}
</script>
{% endblock %}
