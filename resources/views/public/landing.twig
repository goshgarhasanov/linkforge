{% extends 'layouts/base.twig' %}

{% block title %}LinkForge — Peşəkar URL Qısaltma və Analitika Platforması{% endblock %}

{% block body %}
{% include 'partials/nav.twig' %}

<main>
    {# Hero #}
    <section class="relative overflow-hidden">
        <div class="absolute inset-0 bg-gradient-to-br from-brand-50 via-white to-purple-50 dark:from-slate-950 dark:via-slate-900 dark:to-purple-950/30"></div>
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(99,102,241,0.15),transparent_50%)]"></div>

        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 pb-24 sm:pt-28 sm:pb-32">
            <div class="text-center max-w-4xl mx-auto animate-slide-up">
                <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-brand-100 dark:bg-brand-900/30 text-brand-700 dark:text-brand-300 text-sm font-medium mb-6">
                    <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
                    Yeni: Real vaxt analitika dashboard-u
                </div>
                <h1 class="text-5xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight mb-6">
                    Uzun linkləri <span class="gradient-text">güclü</span> linklərə çevirin
                </h1>
                <p class="text-lg sm:text-xl text-slate-600 dark:text-slate-400 mb-10 max-w-2xl mx-auto leading-relaxed">
                    LinkForge ilə linklərinizi qısaldın, hər klikni izləyin və auditoriyanızı dərindən tanıyın. Heç bir gizli qiymət, sənaye səviyyəli analitika.
                </p>

                {# Shortener form #}
                <form
                    x-data="shortener()"
                    @submit.prevent="shorten"
                    class="max-w-2xl mx-auto bg-white dark:bg-slate-900 rounded-2xl shadow-2xl shadow-brand-500/10 p-2 flex flex-col sm:flex-row gap-2 mb-8 border border-slate-200 dark:border-slate-800">
                    <input
                        x-model="url"
                        type="url"
                        required
                        placeholder="https://uzun-linki-buraya-yapışdırın.com/..."
                        class="flex-1 px-5 py-4 bg-transparent border-0 focus:ring-0 text-slate-900 dark:text-white placeholder-slate-400 text-base">
                    <button
                        type="submit"
                        :disabled="loading"
                        class="px-8 py-4 rounded-xl bg-gradient-to-r from-brand-600 to-purple-600 text-white font-semibold shadow-lg shadow-brand-500/30 hover:shadow-xl hover:shadow-brand-500/40 disabled:opacity-50 disabled:cursor-not-allowed transition">
                        <span x-show="!loading">Qısalt →</span>
                        <span x-show="loading">Yüklənir...</span>
                    </button>
                </form>

                <div x-data class="flex items-center justify-center gap-6 text-sm text-slate-500 dark:text-slate-400">
                    <span class="flex items-center gap-1"><svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> Pulsuz başla</span>
                    <span class="flex items-center gap-1"><svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> Kart tələb olunmur</span>
                    <span class="flex items-center gap-1"><svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg> 99.9% uptime</span>
                </div>
            </div>
        </div>
    </section>

    {# Features #}
    <section id="features" class="py-24 bg-white dark:bg-slate-950">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <span class="text-brand-600 dark:text-brand-400 font-semibold text-sm uppercase tracking-wider">Xüsusiyyətlər</span>
                <h2 class="text-4xl sm:text-5xl font-bold mt-3 mb-4">Bir linkdən daha çoxu</h2>
                <p class="text-lg text-slate-600 dark:text-slate-400">Sadəcə qısaltmaq deyil — anlamaq, idarə etmək və miqyaslandırmaq.</p>
            </div>

            <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
                {% set features = [
                    { icon: '📊', title: 'Real vaxt analitika', desc: 'Hər klik anında: coğrafiya, cihaz, brauzer və referrer mənbələri.' },
                    { icon: '🎯', title: 'Xüsusi alias', desc: 'Brendinizə uyğun linklər: linkforge.io/portfoliom kimi.' },
                    { icon: '🔒', title: 'Şifrəli linklər', desc: 'Həssas linkləri şifrə ilə qoruyun, yalnız siz təyin edənlər açsın.' },
                    { icon: '⏰', title: 'Müddət təyini', desc: 'Linklər müəyyən tarixdən və ya klik sayından sonra avtomatik söndürülür.' },
                    { icon: '📱', title: 'QR kod generasiyası', desc: 'Hər linki üçün PNG və SVG formatda yüksək keyfiyyətli QR kod.' },
                    { icon: '🚀', title: 'RESTful API', desc: 'Linkləri proqramlı şəkildə idarə edin. Tam OpenAPI sənədləşməsi.' },
                    { icon: '🌍', title: 'Coğrafi xəritə', desc: 'Auditoriyanızın hansı ölkə və şəhərlərdən olduğunu görün.' },
                    { icon: '🛡️', title: 'Bot qoruması', desc: 'Şübhəli kliklər avtomatik aşkarlanır, statistikanız təmiz qalır.' },
                    { icon: '📦', title: 'Toplu idxal', desc: 'CSV faylından minlərlə linki bir kliklə yaradın və idarə edin.' },
                ] %}

                {% for f in features %}
                <div class="group p-6 rounded-2xl bg-gradient-to-br from-slate-50 to-white dark:from-slate-900 dark:to-slate-900/50 border border-slate-200 dark:border-slate-800 hover:border-brand-300 dark:hover:border-brand-700 hover:shadow-xl hover:-translate-y-1 transition-all duration-300">
                    <div class="text-4xl mb-4">{{ f.icon }}</div>
                    <h3 class="text-lg font-semibold mb-2 group-hover:text-brand-600 dark:group-hover:text-brand-400 transition">{{ f.title }}</h3>
                    <p class="text-slate-600 dark:text-slate-400 text-sm leading-relaxed">{{ f.desc }}</p>
                </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# Stats #}
    <section class="py-20 bg-gradient-to-br from-brand-600 to-purple-700 text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
                <div><div class="text-5xl font-extrabold mb-2">10M+</div><div class="text-brand-100">Qısaldılmış link</div></div>
                <div><div class="text-5xl font-extrabold mb-2">450M+</div><div class="text-brand-100">İzlənilmiş klik</div></div>
                <div><div class="text-5xl font-extrabold mb-2">180+</div><div class="text-brand-100">Ölkə</div></div>
                <div><div class="text-5xl font-extrabold mb-2">99.99%</div><div class="text-brand-100">Uptime</div></div>
            </div>
        </div>
    </section>

    {# Pricing #}
    <section id="pricing" class="py-24 bg-slate-50 dark:bg-slate-900">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center max-w-2xl mx-auto mb-16">
                <span class="text-brand-600 dark:text-brand-400 font-semibold text-sm uppercase tracking-wider">Qiymətlər</span>
                <h2 class="text-4xl sm:text-5xl font-bold mt-3 mb-4">Sadə və şəffaf</h2>
                <p class="text-lg text-slate-600 dark:text-slate-400">Sizə uyğun planı seçin. İstənilən vaxt dəyişdirə bilərsiniz.</p>
            </div>

            <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
                <div class="p-8 rounded-2xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
                    <h3 class="text-lg font-semibold mb-2">Pulsuz</h3>
                    <div class="text-4xl font-bold mb-1">0₼<span class="text-base font-normal text-slate-500">/ay</span></div>
                    <p class="text-sm text-slate-500 mb-6">Şəxsi istifadə üçün</p>
                    <ul class="space-y-3 text-sm mb-8">
                        <li class="flex gap-2">✓ 50 link/ay</li>
                        <li class="flex gap-2">✓ Əsas analitika</li>
                        <li class="flex gap-2">✓ QR kod</li>
                    </ul>
                    <a href="/register" class="block text-center py-3 rounded-lg border border-slate-300 dark:border-slate-700 font-medium hover:bg-slate-100 dark:hover:bg-slate-800 transition">Başla</a>
                </div>

                <div class="p-8 rounded-2xl bg-gradient-to-br from-brand-600 to-purple-600 text-white shadow-2xl shadow-brand-500/30 transform md:scale-105">
                    <div class="inline-block px-3 py-1 rounded-full bg-white/20 text-xs font-semibold mb-3">ƏN POPULYAR</div>
                    <h3 class="text-lg font-semibold mb-2">Pro</h3>
                    <div class="text-4xl font-bold mb-1">19₼<span class="text-base font-normal opacity-80">/ay</span></div>
                    <p class="text-sm opacity-80 mb-6">Peşəkarlar üçün</p>
                    <ul class="space-y-3 text-sm mb-8">
                        <li class="flex gap-2">✓ Limitsiz link</li>
                        <li class="flex gap-2">✓ Genişləndirilmiş analitika</li>
                        <li class="flex gap-2">✓ Xüsusi alias</li>
                        <li class="flex gap-2">✓ API girişi</li>
                        <li class="flex gap-2">✓ Şifrə qoruması</li>
                    </ul>
                    <a href="/register?plan=pro" class="block text-center py-3 rounded-lg bg-white text-brand-700 font-semibold hover:bg-slate-50 transition">Pro-ya keç</a>
                </div>

                <div class="p-8 rounded-2xl bg-white dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
                    <h3 class="text-lg font-semibold mb-2">Enterprise</h3>
                    <div class="text-4xl font-bold mb-1">Fərdi</div>
                    <p class="text-sm text-slate-500 mb-6">Komandalar üçün</p>
                    <ul class="space-y-3 text-sm mb-8">
                        <li class="flex gap-2">✓ Hər şey Pro-da</li>
                        <li class="flex gap-2">✓ SSO və SAML</li>
                        <li class="flex gap-2">✓ SLA təminatı</li>
                        <li class="flex gap-2">✓ Dedicated dəstək</li>
                    </ul>
                    <a href="/contact" class="block text-center py-3 rounded-lg border border-slate-300 dark:border-slate-700 font-medium hover:bg-slate-100 dark:hover:bg-slate-800 transition">Bizimlə əlaqə</a>
                </div>
            </div>
        </div>
    </section>

    {# CTA #}
    <section class="py-24 bg-white dark:bg-slate-950">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
            <h2 class="text-4xl sm:text-5xl font-bold mb-6">Bu gün başlamağa hazırsınız?</h2>
            <p class="text-lg text-slate-600 dark:text-slate-400 mb-8">Heç bir kredit kartı tələb olunmur. 60 saniyədə qeydiyyatdan keçin.</p>
            <a href="/register" class="inline-flex items-center gap-2 px-8 py-4 rounded-xl bg-gradient-to-r from-brand-600 to-purple-600 text-white font-semibold shadow-xl shadow-brand-500/30 hover:shadow-2xl hover:shadow-brand-500/40 transition">
                Pulsuz qeydiyyat
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
        </div>
    </section>
</main>

{% include 'partials/footer.twig' %}

<script>
function shortener() {
    return {
        url: '',
        loading: false,
        async shorten() {
            if (!this.url) return;
            this.loading = true;
            try {
                const res = await fetch('/api/v1/links', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ url: this.url }),
                });
                const json = await res.json();
                if (json.success) {
                    window.location.href = '/register?prefill=' + encodeURIComponent(json.data.short_url);
                } else {
                    alert(json.error?.message ?? 'Xəta baş verdi.');
                }
            } catch (e) {
                alert('Bağlantı xətası baş verdi.');
            } finally {
                this.loading = false;
            }
        }
    }
}
</script>
{% endblock %}
