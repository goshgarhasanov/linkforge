{% extends 'layouts/base.twig' %}

{% block title %}Şifrə tələb olunur — LinkForge{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center px-4 bg-gradient-to-br from-slate-50 to-brand-50 dark:from-slate-950 dark:to-purple-950/30">
    <div class="max-w-md w-full bg-white dark:bg-slate-900 rounded-2xl shadow-2xl p-8 border border-slate-200 dark:border-slate-800">
        <div class="text-center mb-6">
            <div class="w-16 h-16 mx-auto rounded-2xl bg-gradient-to-br from-brand-500 to-purple-600 flex items-center justify-center mb-4 shadow-lg shadow-brand-500/30">
                <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                </svg>
            </div>
            <h1 class="text-2xl font-bold mb-2">Bu link qorunur</h1>
            <p class="text-slate-600 dark:text-slate-400 text-sm">Davam etmək üçün şifrəni daxil edin.</p>
        </div>

        <form method="POST" action="/{{ link.short_code }}/unlock" class="space-y-4">
            <div>
                <input
                    type="password"
                    name="password"
                    required
                    autofocus
                    placeholder="Şifrə"
                    class="w-full px-4 py-3 rounded-xl border border-slate-300 dark:border-slate-700 bg-slate-50 dark:bg-slate-950 focus:ring-2 focus:ring-brand-500 focus:border-transparent transition">
            </div>

            {% if error %}
            <div class="px-4 py-3 rounded-lg bg-red-50 dark:bg-red-950/30 border border-red-200 dark:border-red-900 text-red-700 dark:text-red-400 text-sm">
                {{ error }}
            </div>
            {% endif %}

            <button type="submit" class="w-full py-3 rounded-xl bg-gradient-to-r from-brand-600 to-purple-600 text-white font-semibold shadow-lg shadow-brand-500/30 hover:shadow-xl transition">
                Davam et
            </button>
        </form>
    </div>
</div>
{% endblock %}
